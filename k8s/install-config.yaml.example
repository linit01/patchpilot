patchpilot:
  # version and tag default to the VERSION file at the repo root.
  # Override here only if you need a specific version different from the repo.
  # version: 0.9.8-alpha
  namespace: patchpilot
  image:
    strategy: registry
    # Docker Hub repo — change to your own repo if self-building, or leave as-is for the public image
    dockerHubRepo: linit01/patchpilot
    # Use the clean tag (no -amd64 / -arm64 suffix).
    # The public image is a multi-arch manifest list — Docker/k8s pull the right arch automatically.
    # If you built with ./k8s/build-push.sh (dev mode, no --release), use the arch-suffixed tag instead.
    # tag: 0.9.8-alpha
    # IfNotPresent uses the local k3s image cache for known versioned tags
    # (backend-1.x.x); only pulls when the tag changes (e.g. via in-app
    # self-update). Setting Always re-pulls on every pod restart and breaks
    # if the tag has been removed from the registry. Switch to Always only
    # if you're chasing a mutable tag like :latest.
    pullPolicy: IfNotPresent
  dockerHub:
    # Only needed if using a private image repo (--developer mode)
    # Leave blank for the public image
    username: ''
    token: ''
  network:
    hostname: patchpilot.lan        # Hostname your ingress should respond to
    additionalHostnames: []
    tls:
      enabled: false                # Set true to enable HTTPS
      mode: acme                    # acme (cert-manager + Let's Encrypt) or byo (bring your own cert)
      clusterIssuer: letsencrypt-prod  # acme mode only
      secretName: ''                # byo mode: name of your pre-created `kubernetes.io/tls` secret
                                    #   kubectl create secret tls <name> --cert=your.crt --key=your.key -n patchpilot
                                    #   Use byo for internal hostnames (e.g. *.apps.lan) that public ACME can't validate.
    httpsRedirect: true
    securityHeaders: true
    ingressClass: traefik
  certManager:
    createClusterIssuer: true
    email: ''                       # your@email.com — used for Let's Encrypt registration
    challengeType: dns01-cloudflare # or http01
    cloudflare:
      email: ''                     # Cloudflare account email (dns01 only)
      apiTokenSecretName: cloudflare-api-token-secret
  postgres:
    user: patchpilot
    password: ''                    # Leave blank — installer generates a strong password
    database: patchpilot
    storageSize: 5Gi
    storageClass: local-path        # Change to match your cluster's StorageClass (leave blank to auto-detect the cluster default)
  app:
    encryptionKey: ''               # Leave blank — installer auto-generates a Fernet key
    autoRefreshInterval: 60
    defaultSshUser: root
    defaultSshPort: 22
    backupRetainCount: 3
    maxBackupSizeMb: 500
  storage:
    dataDir: /app-data               # Parent directory for hostPath PVs on the node
    type: local                     # local or nfs
    storageClass: local-path        # Change to match your cluster's StorageClass
    backupsSize: 10Gi
    ansibleSize: 1Gi
    nfsServer: ''                   # NFS server IP (nfs type only)
    nfsShare: ''                    # NFS export path (nfs type only)
